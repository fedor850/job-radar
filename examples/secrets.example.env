# Job Radar — secrets. Copy to <JOBRADAR_HOME>/secrets.env (NEVER into the repository) and fill in.
# deploy.sh copies everything except SSH_* to the server as /etc/jobradar/secrets.env (mode 640).

# --- required ---------------------------------------------------------------
# Telegram bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
# Claude API key from https://platform.claude.com → API keys (set a monthly spend limit there!)
ANTHROPIC_API_KEY=replace-with-your-sk-ant-key
# Public IPv4 of your server (used by deploy.sh only)
SERVER_IP=203.0.113.10

# --- recommended ------------------------------------------------------------
# Your Telegram chat ID. If empty, the FIRST person who sends /start to the bot becomes its owner —
# so either fill this in or send /start right after the first deploy. (Get it from @userinfobot.)
TELEGRAM_CHAT_ID=

# --- Google tracker & Gmail bridge (optional, see docs/google-bridge.md) ----
# Web-app URL of your Apps Script deployment and a long random shared secret (e.g. `openssl rand -hex 24`)
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# --- optional job APIs ------------------------------------------------------
JOOBLE_API_KEY=
CAREERJET_API_KEY=

# --- deploy.sh only (not copied to the server) ------------------------------
# SSH_USER=root
# SSH_KEY=/path/to/private/key        (default: <JOBRADAR_HOME>/keys/jobradar_ed25519)
